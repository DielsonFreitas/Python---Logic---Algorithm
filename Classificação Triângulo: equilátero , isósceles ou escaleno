print("Classificação Triângulo: equilátero , isósceles ou escaleno")

lado1 = float (input ("Tamanho lado 1: "))
lado2 = float (input ("Tamanho lado 2: "))
lado3 = float (input ("Tamanho lado 3: "))

if lado1 == lado2 and lado2 == lado3:
  print("Equilátero!")

elif lado1 == lado2 or lado2 == lado3 or lado1:
  print("Isósceles!")

else:
  print("Escaleno!")
