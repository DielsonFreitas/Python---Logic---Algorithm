print("===== Opções/Escolha de Pagamento =====")

def principal():
  print("[1] - Dinheiro")
  print("[2] - Cartão de Crédito")
  print("[3] - Cartão de Débito")
  print("[4] - Pix")
  print("[5] - Boleto")


  opcao = int (input("Escolha umas das opções/forma de pagamento: "))

  pagamento = escolha_de_pagamento (opcao)

  print("Forma de pagamento: ", pagamento)


def escolha_de_pagamento(opcao):

  match opcao:

    case 1:
      return "Dinheiro"

    case 2:
      return "Cartão de Crédito"

    case 3:
      return "Cartão de Débito"

    case 4:
      return "Pix"

    case 5:
      return "Boleto"

    case 6:
      return "Opção Inválida!"

principal ()
